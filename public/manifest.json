{
  "name": "DELTAgroup REPORT Admin",
  "short_name": "DR Admin",
  "description": "Gestione rapporti di servizio — Amministratore",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "launch_handler": { "client_mode": "navigate-existing" },
  "handle_links": "preferred",
  "protocol_handlers": [
    { "protocol": "web+deltareport", "url": "/?report=%s" }
  ],
  "background_color": "#0f3d0f",
  "theme_color": "#1B6B1B",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
